{
  "name": "gamezaar-android-export",
  "version": "0.1.0",
  "private": true,
  "description": "Android packaging foundation for GAMEZAAR Studio game exports",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "build:admob": "esbuild admob-runtime.js --bundle --platform=browser --format=iife --target=es2020 --outfile=www/admob-runtime.bundle.js"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@capacitor-community/admob": "7.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/cli": "7.4.3",
    "esbuild": "^0.25.0"
  }
}
